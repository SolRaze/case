#!/usr/bin/env python3
"""Build every phone x style: STL into out/<phone>/<style>.stl, a preview into
previews/<phone>/<style>.png, each checked (manifold, one solid, glass gap).

    ./build                         every style, for the 17e
    ./build magsafe frame           these styles
    ./build --phone 16 --phone air  these phones
    ./build --all                   every phone in ref/iphone/sizes.json
    ./build --check                 check only, write nothing
    ./build --no-png                STL only

One process per phone keeps memory bounded. A phone and style that ref/rules.json
rules out is skipped and says why; any other failure exits non-zero.
"""

import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
PY = ROOT / ".venv/bin/python"
CASE = ROOT / "blender/case.py"


def main(argv):
    names, styles, i = [], [], 0
    while i < len(argv):
        if argv[i] == "--phone":
            names.append(argv[i + 1])
            i += 2
            continue
        if not argv[i].startswith("--"):
            styles.append(argv[i])
        i += 1
    if "--all" in argv:
        names = list(json.loads((ROOT / "ref/iphone/sizes.json").read_text())["phones"])
    names = names or ["17e"]
    known = json.loads((ROOT / "blender/styles.json").read_text())
    bad = [s for s in styles if s not in known]
    if bad:
        raise SystemExit(f"no style named {', '.join(bad)}; styles are {', '.join(known)}")
    extra = [a for s in styles for a in ("--style", s)]
    if "--check" not in argv:
        extra += ["--out", str(ROOT / "out")]
        if "--no-png" not in argv:
            extra += ["--png", str(ROOT / "previews")]
    py = str(PY if PY.exists() else sys.executable)
    failed = []
    for n in names:
        r = subprocess.run([py, str(CASE), "--", "--phone", n, *extra], cwd=ROOT,
                           capture_output=True, text=True, env={**os.environ, "PYTHONUNBUFFERED": "1"})
        for line in r.stdout.splitlines():
            if line.startswith(("ok ", "FAIL", "skip", "  ")) or "failed" in line or ": " in line and line.split(":")[0] == n:
                print(line)
        if r.returncode:
            failed.append(n)
            if "Traceback" in r.stderr:
                print(r.stderr[-2000:])
    if failed:
        raise SystemExit(f"failed: {', '.join(failed)}")


if __name__ == "__main__":
    main(sys.argv[1:])
